# Microsoft Teams channel plugin — environment variables
#
# Copy this file to ~/.claude/channels/teams/.env once installed, then fill in
# the values from your Azure Bot Service registration. The plugin loads that
# file on boot (real shell environment wins).
#
# Real values are credentials. Never commit them.

# ── Required ────────────────────────────────────────────────────────────────

# App (client) ID of the Entra ID application backing your Teams bot.
# Found in the Azure portal under "App registrations" → your app → Overview.
TEAMS_BOT_APP_ID=<app-id-guid>

# Client secret for the same app registration.
# Created under "Certificates & secrets". Treat as a high-value credential —
# rotation cadence is a function of your tenant's secret policy.
TEAMS_BOT_APP_PASSWORD=<client-secret>

# Authentication mode. One of:
#   MultiTenant         — accept tokens issued by any Entra ID tenant
#   SingleTenant        — accept tokens from a specific tenant only (recommended)
#   UserAssignedMSI     — managed identity (advanced; see docs/azure-setup.md)
TEAMS_BOT_APP_TYPE=SingleTenant

# Required when TEAMS_BOT_APP_TYPE=SingleTenant.
# The tenant GUID that owns the bot registration. Found on the same overview page.
TEAMS_BOT_TENANT_ID=<tenant-id-guid>

# ── HTTP listener ───────────────────────────────────────────────────────────

# Address and port the plugin's HTTPS listener binds to. The Bot Framework
# service POSTs activities here.
#
# In production this is reached via a reverse proxy / public hostname; the
# plugin itself only listens on this local address. See docs/architecture.md.
TEAMS_PLUGIN_BIND_HOST=127.0.0.1
TEAMS_PLUGIN_PORT=3979

# Public messaging endpoint URL configured against the Azure Bot resource.
# Used for diagnostics, the /teams:configure status output, AND as the base of
# send_file download links: its origin + /files (the same tunnel Azure uses
# reaches the plugin's /files/<token> route). Must be https. Without it (and
# without TEAMS_FILES_BASE_URL) send_file is disabled; text replies still work.
# setup-azure-bot.sh writes it for you.
# Example: https://teams-bot.example.com/api/messages
TEAMS_BOT_ENDPOINT_URL=<public-https-endpoint>

# ── Optional ────────────────────────────────────────────────────────────────

# Base URL for send_file download links, when it differs from the endpoint's
# origin + /files (e.g. files served behind another reverse-proxy path). https only.
# TEAMS_FILES_BASE_URL=https://teams-bot.example.com/files

# Shared conversations (channels, group chats) where messages from allowlisted
# users reach Claude without an @mention of the bot. Comma-separated
# conversation ids without the ';messageid=...' part (the channel id), or '*'
# for every shared conversation. Default: empty = @mention required everywhere.
# Non-allowlisted senders are never paired from an unmentioned message.
# TEAMS_UNMENTIONED_CONVERSATIONS=19:abc123@thread.tacv2
# Channels where Claude may start a NEW top-level post with the post_to_channel
# tool. Comma-separated channel ids (a channel message's conversation id without
# ';messageid=...'). No wildcard. Default: empty = tool disabled. After enabling,
# an allowlisted user must write once in the channel so the bot learns its route.
# Enabling a channel lets Claude post there on its own initiative.
# TEAMS_PROACTIVE_CHANNELS=19:abc123@thread.tacv2

# Teams targeted messages (seen by one member of a channel or group chat). When on,
# the permission prompt may go to the channel the operator used last, shown only to
# them, and an unknown sender there gets the pairing code the same way. Off by
# default: the prompt goes only to a 1:1 chat and pairing happens in a 1:1 chat.
# Turn it on only after checking it live: if Teams ignored the flag, everyone in
# the conversation would see the prompt and the code.
# TEAMS_TARGETED_MESSAGES=1

# Override the on-disk state directory. Default: ~/.claude/channels/teams
# Use this to run multiple isolated bots on the same host.
# TEAMS_STATE_DIR=

# When set, snapshot access policy at boot and never re-read or write it.
# Pairing is downgraded to allowlist in this mode (see docs/pairing.md).
# TEAMS_ACCESS_MODE=static
